# ===== Job Portal - root environment for docker compose =====
# Quick start:  sh scripts/gen-secrets.sh   (creates .env with random JWT_SEC / INTERNAL_API_KEY)

# Public URL users open in the browser (used in password-reset emails)
PUBLIC_URL=http://localhost

# OAuth callback base URL. For the Docker/nginx stack, keep this the public app URL.
OAUTH_CALLBACK_BASE_URL=http://localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Clerk development auth (free shared Google + LinkedIn OAuth for local development)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres (Neon) connection string shared by auth, job, user, payment
DB_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Secrets - generate with: openssl rand -hex 32
JWT_SEC=
INTERNAL_API_KEY=

# Razorpay (https://dashboard.razorpay.com). KEY_ID is public, the other two are secret.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUBSCRIPTION_PRICE_INR=119

# Cloudinary (file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP (use an App Password, not your login password)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Gemini (resume analyser + career guide)
GEMINI_API_KEY=
